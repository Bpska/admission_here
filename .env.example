DATABASE_URL="postgresql://postgres:bps@localhost:5432/admission_db?schema=public"
DIRECT_URL="postgresql://postgres:bps@localhost:5432/admission_db?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Required for production. Generate a private value with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: enables AI blog drafts. Leave blank for starter drafts.
OPENAI_API_KEY=

# Model used for title-to-article generation when OPENAI_API_KEY is set.
BLOG_DRAFT_MODEL=gpt-4o-mini
